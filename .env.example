# Local development configuration. Copy to `.env` and adjust as needed:
#   cp .env.example .env
# docker compose reads `.env` automatically (env_file + ${VAR} interpolation).
# Production values are set in the Railway dashboard, NOT committed here.

# --- Postgres (db service) ---
POSTGRES_USER=sudoku
POSTGRES_PASSWORD=sudoku
POSTGRES_DB=sudoku

# --- Host port mappings (change if these clash locally) ---
DB_PORT=5432
API_PORT=4000
WEB_PORT=3000

# --- Database URL ---
# Points at localhost for host-run tools (drizzle-kit generate/migrate/studio,
# `pnpm db:seed`). The api AND web services override this to `@db:5432` inside
# the compose network (web's SSR loaders read Learn content from Postgres).
DATABASE_URL=postgres://sudoku:sudoku@localhost:5432/sudoku

# --- Web -> API ---
VITE_API_URL=http://localhost:4000

# --- Public site origin ---
# Used for canonical URLs and og:url in page metadata (see
# apps/web/src/features/seo/meta.ts) and by `pnpm --filter @sudoku/db sitemap`
# as SITE_URL. Must be the real public origin, with no trailing slash —
# relative URLs are not valid in either tag. Falls back to the Railway domain
# if unset, so a missing value degrades to correct rather than to localhost.
VITE_SITE_URL=http://localhost:3000
